# copy this file to .env and fill it in. .env is ignored by git, never commit your key.

# your Anthropic API key, for the assistant page
ANTHROPIC_API_KEY=

# the model the assistant uses: a model name from Anthropic's model list
ANTHROPIC_MODEL=

# ways to be told when a watchlist position crosses its break-even or reaches its target. the Watchlist page always
# shows every alert, so all of this is optional.

# email: needs the address, a mail server, and usually a login. for Gmail, SMTP_HOST=smtp.gmail.com and use an app password
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# who it says it is from. defaults to SMTP_USER
SMTP_FROM=
# starttls (the default, port 587), ssl (port 465) or none (only for a mail server on this machine, and never with a login)
SMTP_TLS=

# a webhook address. Slack, Mattermost, Discord and most automation tools give you one. keep it secret
ALERT_WEBHOOK_URL=
